# =============================================================
# pagamentos — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# =============================================================

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Locaweb IMAP
IMAP_HOST=imap.locaweb.com.br
IMAP_PORT=993
IMAP_USER=seu@email.com.br
IMAP_PASS=sua_senha
IMAP_SSL=true
IMAP_MAILBOX=INBOX

# Filtro de palavras-chave (separadas por vírgula — deixe em branco para usar o padrão do código)
EMAIL_KEYWORDS=boleto,nota fiscal,nf-e,nfe,fatura,cobrança,vencimento,pagamento,duplicata,recibo,nfs-e,danfe,simples nacional,simei,darf,gps,gare,guia,guia de pagamento,guia de recolhimento,ct-e,cte,dacte

# Paths locais
PDF_INBOX_PATH=C:\Sheild\Projetos\Claude\Contas a pagar\Pagamentos\data\pdfs_inbox
CSV_OUTPUT_PATH=C:\Sheild\Projetos\Claude\Contas a pagar\Pagamentos\data\csv_output
LOG_PATH=C:\Sheild\Projetos\Claude\Contas a pagar\Pagamentos\logs
