# =============================================================
# pagamentos — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# =============================================================

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=attachments

# Locaweb IMAP
IMAP_HOST=imap.locaweb.com.br
IMAP_PORT=993
IMAP_USER=seu@email.com.br
IMAP_PASS=sua_senha
IMAP_SSL=true
IMAP_MAILBOX=INBOX

# Locaweb SMTP transacional (cobranca-vencidos)
SMTP_HOST=smtplw.com.br
SMTP_PORT=587
SMTP_USER=usuario_do_painel_smtp
SMTP_PASSWORD=senha_do_painel_smtp
# Remetente no domínio do Return Path — sem ele a Locaweb reescreve o From para @smtplw-XX.com.
# O e-mail da company (mailbox real) vira o Reply-To.
SMTP_FROM_ADDR=financeiro@envio.seudominio.com.br

# Filtro de palavras-chave (separadas por vírgula — deixe em branco para usar o padrão do código)
EMAIL_KEYWORDS=boleto,nota fiscal,nf-e,nfe,nfs-e,nfse,danfe,fatura,cobrança,vencimento,vencer,pagamento,duplicata,recibo,comprovante,honorá,mensalidade,parcela,simples nacional,simei,darf,gps,gare,gnre,guia,guia de pagamento,guia de recolhimento,tributo,imposto,taxa,ct-e,cte,dacte,conhecimento de transporte,transporte,frete,fechamento,seguro,apólice,aluguel,condomínio,título,unimed,energia

# Paths locais
PDF_INBOX_PATH=C:\Sheild\Projetos\Claude\Contas a pagar\Pagamentos\data\pdfs_inbox
CSV_OUTPUT_PATH=C:\Sheild\Projetos\Claude\Contas a pagar\Pagamentos\data\csv_output
LOG_PATH=C:\Sheild\Projetos\Claude\Contas a pagar\Pagamentos\logs
