# Arquivos ignorados pelo Git

# Ambiente
.env
*.env.local

# Dependências e builds (rede de segurança — cada app tem seu .gitignore)
node_modules/
dist/
build/

# Dados sensíveis e gerados
data/pdfs_inbox/
data/csv_output/
logs/

# Amostras de validação (boletos reais — CNPJ, valores, linha digitável).
# Ignora todo o conteúdo, mas preserva a estrutura e o README no git.
data/samples/**
!data/samples/**/
!data/samples/README.md
!data/samples/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Editores
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
