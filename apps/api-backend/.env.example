# apps/api-backend — variáveis de ambiente (server-only)
# Copie para .env.local e preencha. NUNCA commitar .env.local.

# Supabase — service_role (acesso total, ignora RLS). Apenas no servidor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Serviço Python interno (Flask, server/app.py) que a ponte aciona.
PYTHON_SERVICE_URL=http://127.0.0.1:8000
