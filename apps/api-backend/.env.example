# apps/api-backend — variáveis de ambiente (server-only)
# Copie para .env.local e preencha. NUNCA commitar .env.local.

# Supabase — service_role (acesso total, ignora RLS). Apenas no servidor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase — chave anon: usada pelo middleware de auth para validar o
# access_token (Authorization: Bearer) do usuário via auth.getUser. NUNCA usar a
# service_role para isso.
SUPABASE_ANON_KEY=eyJ...

# Serviço Python interno (Flask, server/app.py) que a ponte aciona.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Claude API — gateway do chat de IA (lib/ai-chat + POST /api/ai-chat).
# ATENÇÃO: o .env da RAIZ do monorepo (lido pelo pipeline Python) NÃO vale aqui — o Next
# carrega env do diretório do próprio app. Sem esta chave a rota devolve 500, tanto em dev
# quanto na Vercel (onde ela precisa ser cadastrada em Settings → Environment Variables).
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais. Ao trocar o modelo, CONFIRA `cache_read_input_tokens` em analytics.ai_chat_log
# (agrupando por `model`, coluna da migration 129): o mínimo de prefixo cacheável varia por modelo
# e, abaixo dele, o cache_control é ignorado em silêncio (sem erro, só a conta subindo). Ver o
# comentário de CONFIGURED_MODEL em lib/ai-chat/model.ts — e troque o default DE LÁ junto com este.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_TIMEOUT_MS=120000
